// Example for a NEW tailnet. For an existing policy, merge the relevant entries
// instead of replacing it. This policy retains ordinary member network access,
// but limits tagged CI nodes to SSH on the tagged deployment server.
{
  "tagOwners": {
    "tag:moon-flyers-ci": ["autogroup:admin", "autogroup:owner"],
    "tag:moon-flyers-server": ["autogroup:admin", "autogroup:owner"],
    "tag:moon-flyers-funnel": ["autogroup:admin", "autogroup:owner"],
  },
  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["*"],
      "ip": ["*"],
    },
    {
      "src": ["tag:moon-flyers-ci"],
      "dst": ["tag:moon-flyers-server"],
      "ip": ["tcp:22"],
    },
  ],
  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"],
    },
    {
      "action": "check",
      "src": ["autogroup:admin", "autogroup:owner"],
      "dst": ["tag:moon-flyers-server"],
      "users": ["maxence"],
    },
    {
      "action": "accept",
      "src": ["tag:moon-flyers-ci"],
      "dst": ["tag:moon-flyers-server"],
      "users": ["maxence"],
    },
  ],
  "nodeAttrs": [
    {
      "target": ["tag:moon-flyers-funnel"],
      "attr": ["funnel"],
    },
    {
      // Retain existing host Funnel URLs during migration; SSH is independent.
      "target": ["tag:moon-flyers-server"],
      "attr": ["funnel"],
    },
  ],
}
